    <script>
        // Catalog Products Data
        const products = [
            { id: 1, title: 'Royal Wool Trench Coat', category: 'menswear', priceUSD: 180, image: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=600&q=80' },
            { id: 2, title: 'Silk Evening Blazer', category: 'womenswear', priceUSD: 210, image: 'https://images.unsplash.com/photo-1584273143981-41c073dfe8f8?auto=format&fit=crop&w=600&q=80' },
            { id: 3, title: 'Bespoke Leather Chrono Strap', category: 'accessories', priceUSD: 65, image: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=600&q=80' },
            { id: 4, title: 'Cashmere Executive Sweater', category: 'menswear', priceUSD: 140, image: 'https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?auto=format&fit=crop&w=600&q=80' },
            { id: 5, title: 'Tailored Linen Trousers', category: 'womenswear', priceUSD: 110, image: 'https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=600&q=80' },
            { id: 6, title: 'Signature Gold Monogram Belt', category: 'accessories', priceUSD: 85, image: 'https://images.unsplash.com/photo-1624222247344-550fb60583dc?auto=format&fit=crop&w=600&q=80' }
        ];

        let cart = JSON.parse(localStorage.getItem('elf_cart')) || [];
        let currentCurrency = 'USD';
        let conversionRatePKR = 278; // 1 USD = 278 PKR
        let activeDiscount = 0;

        // Initialize Icons
        lucide.createIcons();

        // Render Catalog
        function renderProducts(cat = 'all', query = '') {
            const grid = document.getElementById('productGrid');
            grid.innerHTML = '';
            
            const filtered = products.filter(p => {
                const matchesCat = (cat === 'all' || p.category === cat);
                const matchesSearch = p.title.toLowerCase().includes(query.toLowerCase());
                return matchesCat && matchesSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-gray-400">No products found.</div>`;
                return;
            }

            filtered.forEach(p => {
                const priceFormatted = formatPrice(p.priceUSD);
                grid.innerHTML += `
                    <div class="group bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
                        <div class="relative overflow-hidden aspect-[3/4]">
                            <img src="${p.image}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="${p.title}">
                            <button onclick="addToCart(${p.id})" class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-md text-brand-950 font-bold py-3 rounded-xl shadow-lg hover:bg-brand-950 hover:text-white transition flex items-center justify-center gap-2">
                                <i data-lucide="plus" class="w-4 h-4"></i> Add to Cart
                            </button>
                        </div>
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-[10px] uppercase font-bold text-brand-600 tracking-wider">${p.category}</span>
                                <h3 class="font-serif font-bold text-gray-900 text-lg mt-1">${p.title}</h3>
                            </div>
                            <div class="mt-4 font-bold text-gray-900 text-lg">
                                ${priceFormatted}
                            </div>
                        </div>
                    </div>
                `;
            });
            lucide.createIcons();
        }

        // Format Currency
        function formatPrice(usdVal) {
            if (currentCurrency === 'PKR') {
                return `Rs. ${(usdVal * conversionRatePKR).toLocaleString()}`;
            }
            return `$${usdVal.toFixed(2)}`;
        }

        // Category Filter Setup
        function setCategory(cat) {
            document.querySelectorAll('.cat-filter').forEach(btn => {
                if (btn.dataset.cat === cat) {
                    btn.className = 'cat-filter bg-brand-950 text-white text-xs font-semibold uppercase px-4 py-2 rounded-full transition';
                } else {
                    btn.className = 'cat-filter bg-white text-gray-600 hover:bg-gray-100 border text-xs font-semibold uppercase px-4 py-2 rounded-full transition';
                }
            });
            renderProducts(cat);
        }

        // Cart Drawer Operations
        function toggleCart(open) {
            const drawer = document.getElementById('cartDrawer');
            const panel = document.getElementById('cartPanel');
            const backdrop = document.getElementById('cartBackdrop');

            if (open) {
                drawer.classList.remove('pointer-events-none');
                backdrop.classList.remove('opacity-0');
                panel.classList.remove('translate-x-full');
            } else {
                panel.classList.add('translate-x-full');
                backdrop.classList.add('opacity-0');
                setTimeout(() => drawer.classList.add('pointer-events-none'), 300);
            }
        }

        function addToCart(id) {
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.qty++;
            } else {
                const prod = products.find(p => p.id === id);
                cart.push({ ...prod, qty: 1 });
            }
            updateCartUI();
            toggleCart(true);
        }

        function updateQty(id, delta) {
            const idx = cart.findIndex(i => i.id === id);
            if (idx > -1) {
                cart[idx].qty += delta;
                if (cart[idx].qty <= 0) cart.splice(idx, 1);
            }
            updateCartUI();
        }

        function updateCartUI() {
            localStorage.setItem('elf_cart', JSON.stringify(cart));
            const container = document.getElementById('cartItemsContainer');
            const badge = document.getElementById('cartCountBadge');
            
            const totalCount = cart.reduce((acc, item) => acc + item.qty, 0);
            badge.innerText = totalCount;

            container.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `<p class="text-center text-gray-400 py-12">Your cart is empty.</p>`;
            } else {
                cart.forEach(item => {
                    container.innerHTML += `
                        <div class="flex items-center gap-4 bg-gray-50 p-3 rounded-xl border border-gray-100">
                            <img src="${item.image}" class="w-16 h-16 object-cover rounded-lg" alt="${item.title}">
                            <div class="flex-1">
                                <h4 class="font-bold text-sm text-gray-900">${item.title}</h4>
                                <p class="text-xs text-gray-500">${formatPrice(item.priceUSD)}</p>
                                <div class="flex items-center gap-2 mt-2">
                                    <button onclick="updateQty(${item.id}, -1)" class="w-6 h-6 bg-white border rounded flex items-center justify-center font-bold text-xs">-</button>
                                    <span class="text-xs font-bold">${item.qty}</span>
                                    <button onclick="updateQty(${item.id}, 1)" class="w-6 h-6 bg-white border rounded flex items-center justify-center font-bold text-xs">+</button>
                                </div>
                            </div>
                        </div>
                    `;
                });
            }

            // Totals
            const subtotalUSD = cart.reduce((acc, item) => acc + (item.priceUSD * item.qty), 0);
            const discountUSD = subtotalUSD * activeDiscount;
            const totalUSD = subtotalUSD - discountUSD;

            document.getElementById('cartSubtotal').innerText = formatPrice(subtotalUSD);
            document.getElementById('cartDiscount').innerText = `-${formatPrice(discountUSD)}`;
            document.getElementById('cartTotal').innerText = formatPrice(totalUSD);
        }

        function applyPromo() {
            const code = document.getElementById('promoInput').value.trim().toUpperCase();
            const msg = document.getElementById('promoMessage');
            if (code === 'ELF10') {
                activeDiscount = 0.10;
                msg.innerText = "10% Discount Applied!";
                msg.className = "text-xs mt-1 font-semibold text-green-600";
            } else {
                msg.innerText = "Invalid Promo Code";
                msg.className = "text-xs mt-1 font-semibold text-red-500";
            }
            msg.classList.remove('hidden');
            updateCartUI();
        }

        // Checkout & Receipts
        function handlePlaceOrder(e) {
            e.preventDefault();
            const orderNum = 'ELF-' + Math.floor(100000 + Math.random() * 900000);
            
            document.getElementById('checkoutModal').classList.add('hidden');
            
            const receiptDetails = document.getElementById('receiptDetails');
            receiptDetails.innerHTML = `
                <p><strong>Order ID:</strong> ${orderNum}</p>
                <p><strong>Store Address:</strong> Opposite The Hilton Garden Marquee, Faisalabad</p>
                <p><strong>Contact Email:</strong> enlitenfort@gmail.com</p>
                <p><strong>Items:</strong> ${cart.length} product(s)</p>
                <p><strong>Total Amount:</strong> ${document.getElementById('cartTotal').innerText}</p>
            `;
            
            document.getElementById('receiptModal').classList.remove('hidden');
            cart = [];
            activeDiscount = 0;
            updateCartUI();
            toggleCart(false);
        }

        function closeReceiptModal() {
            document.getElementById('receiptModal').classList.add('hidden');
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text);
            alert('Email address copied to clipboard: ' + text);
        }

        // Event Listeners
        document.getElementById('cartDrawerBtn').addEventListener('click', () => toggleCart(true));
        document.getElementById('cartCloseBtn').addEventListener('click', () => toggleCart(false));
        document.getElementById('cartBackdrop').addEventListener('click', () => toggleCart(false));
        
        document.getElementById('currencySelector').addEventListener('change', (e) => {
            currentCurrency = e.target.value;
            renderProducts();
            updateCartUI();
        });

        document.getElementById('searchOpenBtn').addEventListener('click', () => {
            document.getElementById('searchOverlay').classList.remove('hidden');
        });
        document.getElementById('searchCloseBtn').addEventListener('click', () => {
            document.getElementById('searchOverlay').classList.add('hidden');
        });
        document.getElementById('searchInput').addEventListener('input', (e) => {
            renderProducts('all', e.target.value);
        });

        document.getElementById('checkoutBtn').addEventListener('click', () => {
            if (cart.length === 0) return alert('Your cart is empty.');
            document.getElementById('checkoutModal').classList.remove('hidden');
        });
        document.getElementById('checkoutCloseBtn').addEventListener('click', () => {
            document.getElementById('checkoutModal').classList.add('hidden');
        });

        // Initialize Page
        renderProducts();
        updateCartUI();
    </script>
</body>
</html>
